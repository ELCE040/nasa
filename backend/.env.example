# ─── NAYSA Backend — Production Environment ───────────────────────────────────
# INSTRUCTIONS:
#   1. Upload this file to your server as `.env` inside the backend folder.
#   2. Fill in the values below with your actual Namecheap cPanel MySQL credentials.
#   3. Never commit this file to Git — it is already in .gitignore.

# Server port — cPanel Node.js Selector will override this automatically.
# Leave as 3000 for local testing.
PORT=3000

# MySQL database credentials (get these from cPanel → MySQL Databases)
DB_HOST=localhost
DB_USER=cpanelusername_naysa
DB_PASS=YOUR_STRONG_DB_PASSWORD_HERE
DB_NAME=cpanelusername_naysa_db

# The public URL where your Flutter app can reach this API.
# Example: https://yourdomain.com/api
# Used for CORS whitelisting.
APP_URL=https://yourdomain.com

# Required in production. Generate a long, random value and keep it private;
# changing it invalidates all existing team sessions.
SESSION_SECRET=replace_with_a_long_random_secret

# Cloudflare R2 image storage. R2_PUBLIC_URL must be a public bucket domain
# (a r2.dev URL or custom domain), not the S3 API endpoint.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=naysa-media
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev
